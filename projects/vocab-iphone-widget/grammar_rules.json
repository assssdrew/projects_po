  {"id": "t03", "title": "Pr. Simple vs Continuous", "formula": "usually vs now", "tip": "I work here · I’m working today"},
  {"id": "t04", "title": "Past Simple", "formula": "V2 / did + V1", "tip": "yesterday, ago, last…, in 2022"},
  {"id": "t05", "title": "Past Simple ? / −", "formula": "Did you V1? · didn’t V1", "tip": "Did you go? — No, I didn’t"},
  {"id": "t06", "title": "Present Perfect", "formula": "have/has + V3", "tip": "ever/never · since/for · just/yet"},
  {"id": "t07", "title": "Present Perfect смысл", "formula": "experience / result now", "tip": "сделал — когда неважно"},
  {"id": "t08", "title": "PP vs Past Simple", "formula": "PP: no time · PS: when", "tip": "I’ve been to VN · I went in 2022"},
  {"id": "t09", "title": "Present Perfect Cont.", "formula": "have/has been + Ving", "tip": "how long / lately / still going"},
  {"id": "t10", "title": "PP vs PPC", "formula": "result vs activity", "tip": "I’ve done it · I’ve been doing it"},
  {"id": "s01", "title": "PP markers", "formula": "never/ever · since/for", "tip": "just/already/yet · recently/lately"},
  {"id": "s02", "title": "Past Simple markers", "formula": "yesterday · last · ago", "tip": "in 2008 · when I was…"},
  {"id": "f01", "title": "Future will", "formula": "will + V1", "tip": "decision / opinion / promise"},
  {"id": "f02", "title": "be going to", "formula": "am/is/are going to + V1", "tip": "plan / evidence"},
  {"id": "f03", "title": "Present Cont. = future", "formula": "am/is/are + Ving", "tip": "fixed plan: I’m meeting…"},
  {"id": "f04", "title": "Present Simple = future", "formula": "V1 / Vs", "tip": "timetable: The flight leaves…"},
  {"id": "u01", "title": "used to", "formula": "used to + V1", "tip": "раньше делал, сейчас нет"},
  {"id": "u02", "title": "didn’t use to", "formula": "didn’t use to + V1", "tip": "раньше не делал"},
  {"id": "u03", "title": "be used to", "formula": "be used to + Ving/noun", "tip": "уже привык"},
  {"id": "u04", "title": "get used to", "formula": "get used to + Ving/noun", "tip": "привыкаю / привыкну"},
  {"id": "m01", "title": "must / have to", "formula": "must · have to + V1", "tip": "obligation"},
  {"id": "m02", "title": "should", "formula": "should + V1", "tip": "advice"},
  {"id": "m03", "title": "should have", "formula": "should have + V3", "tip": "надо было, но не…"},
  {"id": "m04", "title": "must have", "formula": "must have + V3", "tip": "наверное было (past)"},
  {"id": "m05", "title": "could have", "formula": "could have + V3", "tip": "мог, но не сделал"},
  {"id": "m06", "title": "would have", "formula": "would have + V3", "tip": "сделал бы (часто + if)"},
  {"id": "g01", "title": "verb + gerund", "formula": "enjoy/avoid/keep + Ving", "tip": "suggest · mind · admit · finish"},
  {"id": "g02", "title": "verb + to-inf", "formula": "decide/hope/want + to V", "tip": "manage · fail · would like"},
  {"id": "g03", "title": "stop doing / to do", "formula": "stop + Ving vs to V", "tip": "stop smoking · stop to smoke"},
  {"id": "g04", "title": "forget / remember", "formula": "Ving = past memory", "tip": "to V = не забыть сделать"},
  {"id": "c00", "title": "Zero Conditional", "formula": "if + Present, Present", "tip": "facts / always true"},
  {"id": "c01", "title": "1st Conditional", "formula": "if + Present, will + V1", "tip": "real future"},
  {"id": "c02", "title": "2nd Conditional", "formula": "if + Past, would + V1", "tip": "unreal now/future"},
  {"id": "c03", "title": "3rd Conditional", "formula": "if + Past Perfect, would have + V3", "tip": "unreal past"},
  {"id": "c04", "title": "if vs when", "formula": "if = maybe · when = sure", "tip": "When I get home…"},
  {"id": "a01", "title": "a / an", "formula": "a + consonant sound", "tip": "an + vowel sound (an hour)"},
  {"id": "a02", "title": "the", "formula": "the = known / unique", "tip": "the sun · the job we discussed"},
  {"id": "a03", "title": "no article", "formula": "Ø plural / uncount general", "tip": "Ø life is hard"},
  {"id": "r01", "title": "who / which / that", "formula": "who=people · which=things", "tip": "that = both (defining)"},
  {"id": "r02", "title": "where", "formula": "where = place", "tip": "the city where I live"},
  {"id": "p01", "title": "to vs for", "formula": "to + V · for + noun/Ving", "tip": "to learn · for learning"},
  {"id": "p02", "title": "in / on / at (time)", "formula": "at 5 · on Monday · in July", "tip": "in the morning · at night"},
  {"id": "pc1", "title": "Past Continuous", "formula": "was/were + Ving", "tip": "was doing when… / while…"},
  {"id": "pc2", "title": "PC + Past Simple", "formula": "was Ving when + V2", "tip": "background + short action"}
